    // 7. LAYANAN WARGA CRUD
    async function fetchLayanan() {
      const res = await fetch('/api/layanan');
      globalLayanan = await res.json();

      // Dynamic Sidebar Badge Count Update
      const baruCount = globalLayanan.filter(l => l.status === 'Baru').length;
      const badgeEl = document.getElementById('layanan-badge-count');
      if (badgeEl) {
        badgeEl.innerText = baruCount.toString();
        if (baruCount === 0) {
          badgeEl.style.display = 'none';
        } else {
          badgeEl.style.display = 'inline-block';
        }
      }

      renderLayananTable();
    }

    function renderLayananTable() {
      const tbody = document.getElementById('layanan-table-body');
      if (!tbody) return;
      const state = stateMap.layanan;

      const filtered = globalLayanan.filter(l => 
        !state.search || 
        l.nama?.toLowerCase().includes(state.search) || 
        l.telepon?.toLowerCase().includes(state.search) || 
        l.kategori?.toLowerCase().includes(state.search)
      );

      const startIndex = (state.page - 1) * state.perPage;
      const paginated = filtered.slice(startIndex, startIndex + state.perPage);

      if (paginated.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding: 24px; color: #94A3B8;">Tidak ada permohonan layanan ditemukan.</td></tr>`;
      } else {
        tbody.innerHTML = paginated.map(item => `
          <tr>
            <td><div class="cell-truncate" title="${item.nama}"><strong>${item.nama}</strong></div></td>
            <td><a href="https://wa.me/${item.telepon.replace(/^0/, '62')}" target="_blank" style="color: #0284C7; text-decoration: underline;">${item.telepon}</a></td>
            <td>${item.kategori}</td>
            <td style="white-space:nowrap;">${new Date(item.createdAt).toLocaleDateString('id-ID')}</td>
            <td><span class="status-badge ${item.status.toLowerCase()}">${item.status}</span></td>
            <td style="text-align: right; white-space:nowrap;">
              <button class="action-icon-btn view-layanan-btn" data-id="${item.id}">Detail</button>
              <button class="action-icon-btn delete delete-layanan-btn" data-id="${item.id}">Hapus</button>
            </td>
          </tr>
        `).join('');
      }

      updatePaginationControls('layanan', filtered.length, state, (p) => {
        state.page = p;
        renderLayananTable();
      });

      document.querySelectorAll('.view-layanan-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          const item = globalLayanan.find(l => l.id === id);
          if (item) openLayananDetail(item);
        });
      });

      document.querySelectorAll('.delete-layanan-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (confirm('Hapus permohonan ini?')) {
            await fetch(`/api/layanan?id=${id}`, { method: 'DELETE' });
            fetchLayanan();
          }
        });
      });
    }

    const layananDetailModal = document.getElementById('layanan-detail-modal');
    const closeLayananDetail = document.getElementById('close-layanan-detail');
    closeLayananDetail?.addEventListener('click', () => layananDetailModal?.classList.add('hidden'));

    function openLayananDetail(item: any) {
      const content = document.getElementById('layanan-detail-content');
      if (!content) return;
      content.innerHTML = `
        <p style="margin-bottom:8px;"><strong>Nama:</strong> ${item.nama}</p>
        <p style="margin-bottom:8px;"><strong>Telepon:</strong> ${item.telepon}</p>
        <p style="margin-bottom:8px;"><strong>Kategori:</strong> ${item.kategori}</p>
        <p style="margin-bottom:8px;"><strong>Tanggal:</strong> ${new Date(item.createdAt).toLocaleString('id-ID')}</p>
        <div style="background:#F1F5F9; padding:12px; border-radius:8px; margin: 12px 0;">
          <strong>Pesan:</strong><br/>
          <p style="margin-top:4px; white-space:pre-line;">${item.pesan}</p>
        </div>
        <div style="display:flex; gap:10px; margin-top:16px;">
          <button class="btn-primary-admin update-status-btn" data-id="${item.id}" data-status="Diproses">Tandai Diproses</button>
          <button class="btn-primary-admin update-status-btn" data-id="${item.id}" data-status="Selesai" style="background:#166534;">Tandai Selesai</button>
        </div>
      `;
      layananDetailModal?.classList.remove('hidden');

      document.querySelectorAll('.update-status-btn').forEach(b => {
        b.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          const status = (e.currentTarget as HTMLElement).getAttribute('data-status');
          await fetch('/api/layanan', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, status })
          });
          layananDetailModal?.classList.add('hidden');
          fetchLayanan();
        });
      });
    }

    // 7. SETTINGS FORM SUBMIT
    const settingsForm = document.getElementById('settings-form') as HTMLFormElement;
    const settingsAlert = document.getElementById('settings-alert');

    settingsForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = {
        siteName: (document.getElementById('setting-siteName') as HTMLInputElement).value,
        subTitle: (document.getElementById('setting-subTitle') as HTMLInputElement).value,
        description: (document.getElementById('setting-description') as HTMLTextAreaElement).value,
        address: (document.getElementById('setting-address') as HTMLInputElement).value,
        phone: (document.getElementById('setting-phone') as HTMLInputElement).value,
        email: (document.getElementById('setting-email') as HTMLInputElement).value,
        social: {
          facebook: (document.getElementById('setting-facebook') as HTMLInputElement).value,
          instagram: (document.getElementById('setting-instagram') as HTMLInputElement).value,
          twitter: (document.getElementById('setting-twitter') as HTMLInputElement).value,
          youtube: (document.getElementById('setting-youtube') as HTMLInputElement).value
        },
        copyright: (document.getElementById('setting-copyright') as HTMLInputElement).value
      };

      try {
        const res = await fetch('/api/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (res.ok && result.success) {
          if (settingsAlert) {
            settingsAlert.innerText = 'Pengaturan website berhasil diperbarui!';
            settingsAlert.className = 'alert-box success';
          }
        }
      } catch (err) {
        if (settingsAlert) {
          settingsAlert.innerText = 'Gagal menyimpan pengaturan.';
          settingsAlert.className = 'alert-box error';
        }
      }
    });
  });
</script>
