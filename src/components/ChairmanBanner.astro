---
// Chairman Banner component matching pdipkotasemarang.id/home 100%
---

<section class="chairman-pdip-section">
  <div class="container chairman-pdip-container">
    <div class="chairman-pdip-card">
      <!-- Left Column: Chairman Cutout Image standing on banner -->
      <div class="pdip-img-col">
        <img 
          src="https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=800&auto=format&fit=crop" 
          alt="H. Bambang Sutrisno, S.T. - Ketua DPC BMI Kab. Tegal" 
          class="chairman-cutout-img"
        />
      </div>

      <!-- Center/Right Column: Text Content -->
      <div class="pdip-text-col">
        <h2 class="chairman-pdip-name">H. Bambang Sutrisno, S.T.</h2>
        <h3 class="chairman-pdip-role">Ketua DPC BMI Kabupaten Tegal</h3>
        <div class="pdip-red-line"></div>

        <p class="chairman-pdip-desc">
          Barisan Muda Indonesia (BMI) Kabupaten Tegal senantiasa hadir dan konsisten bergotong royong melayani kebutuhan warga, memfasilitasi wirausaha muda UMKM desa, serta mengawal aksi sosial dan kemanusiaan di 18 Kecamatan.
        </p>
      </div>

      <!-- Right Side Background: Waving Red PDI / Banteng Flag Graphic -->
      <div class="pdip-flag-bg">
        <div class="flag-wave-container">
          <svg viewBox="0 0 400 250" class="pdip-flag-svg" preserveAspectRatio="xMidYMid slice">
            <defs>
              <linearGradient id="flagRedGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#E30613" />
                <stop offset="60%" stop-color="#B7040E" />
                <stop offset="100%" stop-color="#7A0007" />
              </linearGradient>
              <filter id="shadowGlow">
                <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.3"/>
              </filter>
            </defs>

            <!-- Waving Red Flag Shape -->
            <path d="M0,0 C120,20 240,-15 400,10 L400,250 C240,230 120,260 0,240 Z" fill="url(#flagRedGrad)" opacity="0.92"/>
            
            <!-- Banteng Emblem Circle (PDI Perjuangan Style) -->
            <g transform="translate(260, 95)" filter="url(#shadowGlow)">
              <circle cx="0" cy="0" r="48" fill="#121212" stroke="#FFFFFF" stroke-width="4"/>
              <circle cx="0" cy="0" r="44" fill="none" stroke="#E30613" stroke-width="2"/>
              <!-- Bull Silhouette -->
              <path d="M-22,-4 C-20,-16 -8,-24 0,-24 C8,-24 20,-16 22,-4 C25,4 15,12 8,16 C2,20 0,24 0,28 C0,24 -2,20 -8,16 C-15,12 -25,4 -22,-4 Z" fill="#FFFFFF"/>
              <!-- Bull Horns -->
              <path d="M-18,-12 C-30,-22 -34,-32 -26,-36 C-22,-32 -16,-24 -12,-14 Z" fill="#FFFFFF"/>
              <path d="M18,-12 C30,-22 34,-32 26,-36 C22,-32 16,-24 12,-14 Z" fill="#FFFFFF"/>
              <!-- Red Eye -->
              <circle cx="-7" cy="-8" r="2.5" fill="#E30613"/>
              <circle cx="7" cy="-8" r="2.5" fill="#E30613"/>
            </g>

            <!-- Text BANTENG MUDA INDONESIA -->
            <text x="260" y="168" fill="#FFFFFF" font-family="'Plus Jakarta Sans', sans-serif" font-weight="900" font-size="14" letter-spacing="1.5" text-anchor="middle">
              BANTENG MUDA INDONESIA
            </text>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .chairman-pdip-section {
    padding: 35px 0;
    background-color: #FFFFFF;
  }

  .chairman-pdip-card {
    position: relative;
    background: #F4F4F6;
    border-radius: 18px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 230px 1fr;
    min-height: 230px;
    align-items: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    border: 1px solid #E2E8F0;
  }

  .pdip-img-col {
    position: relative;
    height: 100%;
    min-height: 230px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 10;
  }

  .chairman-cutout-img {
    width: 100%;
    max-width: 210px;
    height: 240px;
    object-fit: cover;
    object-position: top center;
    display: block;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.12));
  }

  .pdip-text-col {
    padding: 24px 30px 24px 0;
    position: relative;
    z-index: 10;
    max-width: 520px;
  }

  .chairman-pdip-name {
    font-size: 1.65rem;
    font-weight: 800;
    color: #121212;
    font-family: var(--font-heading);
    line-height: 1.25;
    margin-bottom: 2px;
  }

  .chairman-pdip-role {
    font-size: 1rem;
    font-weight: 700;
    color: var(--primary-red);
    font-family: var(--font-heading);
    margin-bottom: 8px;
  }

  .pdip-red-line {
    width: 45px;
    height: 3px;
    background-color: var(--primary-red);
    margin-bottom: 12px;
    border-radius: 2px;
  }

  .chairman-pdip-desc {
    font-size: 0.88rem;
    color: #334155;
    line-height: 1.55;
    font-weight: 500;
  }

  /* Waving Red Flag Background Graphic & Animation */
  .pdip-flag-bg {
    position: absolute;
    top: 0;
    right: 0;
    width: 45%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .flag-wave-container {
    width: 100%;
    height: 100%;
    animation: waveFlag 6s ease-in-out infinite alternate;
    transform-origin: right center;
  }

  @keyframes waveFlag {
    0% {
      transform: scale(1) translateY(0px) skewY(0deg);
    }
    50% {
      transform: scale(1.02) translateY(-4px) skewY(-0.8deg);
    }
    100% {
      transform: scale(1.01) translateY(3px) skewY(0.5deg);
    }
  }

  .pdip-flag-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 992px) {
    .chairman-pdip-card {
      grid-template-columns: 1fr;
      padding-top: 24px;
      text-align: center;
    }
    .pdip-img-col {
      min-height: 200px;
    }
    .chairman-cutout-img {
      height: 210px;
    }
    .pdip-text-col {
      padding: 20px 24px 28px 24px;
      max-width: 100%;
    }
    .pdip-red-line {
      margin-left: auto;
      margin-right: auto;
    }
    .pdip-flag-bg {
      width: 100%;
      opacity: 0.25;
    }
  }

  @media (max-width: 640px) {
    .chairman-pdip-name {
      font-size: 1.45rem;
    }
    .chairman-pdip-role {
      font-size: 0.92rem;
    }
    .chairman-pdip-desc {
      font-size: 0.82rem;
    }
  }
</style>
