<script>
  document.addEventListener('DOMContentLoaded', () => {
    const INACTIVITY_LIMIT = 60 * 60 * 1000; // 1 Jam
    let inactivityTimer: any = null;

    const loginScreen = document.getElementById('login-screen');
    const dashboardPanel = document.getElementById('dashboard-panel');
    const loginForm = document.getElementById('login-form') as HTMLFormElement;
    const loginAlert = document.getElementById('login-alert');
    const logoutBtn = document.getElementById('logout-btn');

    function clearSession() {
      localStorage.removeItem('bmi_admin_token');
      localStorage.removeItem('bmi_admin_last_activity');
      if (inactivityTimer) clearTimeout(inactivityTimer);
    }

    function updateActivity() {
      if (!localStorage.getItem('bmi_admin_token')) return;
      const now = Date.now();
      localStorage.setItem('bmi_admin_last_activity', now.toString());

      if (inactivityTimer) clearTimeout(inactivityTimer);
      inactivityTimer = setTimeout(() => {
        triggerAutoLogout();
      }, INACTIVITY_LIMIT);
    }

    function triggerAutoLogout() {
      clearSession();
      if (loginAlert) {
        loginAlert.innerText = 'Sesi berakhir! Anda telah keluar otomatis karena tidak ada aktivitas selama 1 jam.';
        loginAlert.className = 'alert-box error';
      }
      dashboardPanel?.classList.add('hidden');
      loginScreen?.classList.remove('hidden');
    }

    function startInactivityTracker() {
      updateActivity();
      ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'].forEach(evt => {
        window.addEventListener(evt, updateActivity, { passive: true });
      });
    }

    // Check saved session & 1 hour inactivity limit
    const currentAuthToken = localStorage.getItem('bmi_admin_token');
    const lastActivityStr = localStorage.getItem('bmi_admin_last_activity');

    if (currentAuthToken && lastActivityStr) {
      const elapsed = Date.now() - parseInt(lastActivityStr, 10);
      if (elapsed >= INACTIVITY_LIMIT) {
        clearSession();
        if (loginAlert) {
          loginAlert.innerText = 'Sesi Anda telah kadaluwarsa (lebih dari 1 jam tanpa aktivitas). Silakan login kembali.';
          loginAlert.className = 'alert-box error';
        }
      } else {
        showDashboard();
      }
    } else {
      clearSession();
    }

    // Login Form Submit
    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const username = (document.getElementById('username') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();

        if (res.ok && data.success) {
          localStorage.setItem('bmi_admin_token', data.token);
          localStorage.setItem('bmi_admin_last_activity', Date.now().toString());
          showDashboard();
        } else {
          if (loginAlert) {
            loginAlert.innerText = data.error || 'Login gagal';
            loginAlert.className = 'alert-box error';
          }
        }
      } catch (err) {
        if (loginAlert) {
          loginAlert.innerText = 'Gagal menghubungi server auth';
          loginAlert.className = 'alert-box error';
        }
      }
    });

    logoutBtn?.addEventListener('click', () => {
      clearSession();
      location.reload();
    });

    function showDashboard() {
      loginScreen?.classList.add('hidden');
      dashboardPanel?.classList.remove('hidden');
      startInactivityTracker();
      loadAllData();
    }

    // Mobile Hamburger Menu Drawer Toggle
    const mobileToggleBtn = document.getElementById('admin-mobile-toggle');
    const adminSidebar = document.querySelector('.admin-sidebar');
    const sidebarBackdrop = document.getElementById('admin-sidebar-backdrop');

    function closeMobileSidebar() {
      adminSidebar?.classList.remove('mobile-open');
      sidebarBackdrop?.classList.add('hidden');
    }

    function toggleMobileSidebar() {
      const isOpen = adminSidebar?.classList.contains('mobile-open');
      if (isOpen) {
        closeMobileSidebar();
      } else {
        adminSidebar?.classList.add('mobile-open');
        sidebarBackdrop?.classList.remove('hidden');
      }
    }

    mobileToggleBtn?.addEventListener('click', toggleMobileSidebar);
    sidebarBackdrop?.addEventListener('click', closeMobileSidebar);

    // Navigation Tabs
    const navItems = document.querySelectorAll('.sidebar-nav .nav-item');
    const tabContents = document.querySelectorAll('.tab-content');
    const tabTitle = document.getElementById('tab-title');

    const tabTitlesMap: Record<string, string> = {
      overview: 'Ringkasan Dashboard',
      hero: 'Kelola Slide Banner Halaman Beranda',
      about: 'Kelola Konten Halaman Tentang Kami',
      agenda: 'Kelola Program & Agenda Kerja',
      news: 'Kelola Berita & Publikasi Artikel',
      layanan: 'Daftar Permohonan Layanan Warga',
      settings: 'Pengaturan Profil & Kontak Website'
    };

    navItems.forEach(item => {
      item.addEventListener('click', () => {
        const tab = item.getAttribute('data-tab');
        if (!tab) return;

        navItems.forEach(n => n.classList.remove('active'));
        tabContents.forEach(c => c.classList.remove('active'));

        item.classList.add('active');
        document.getElementById(`tab-${tab}`)?.classList.add('active');

        if (tabTitle && tabTitlesMap[tab]) {
          tabTitle.innerText = tabTitlesMap[tab];
        }

        // Auto close mobile drawer on tab selection
        closeMobileSidebar();
      });
    });

    // Quick Actions
    document.getElementById('btn-quick-add-news')?.addEventListener('click', () => openNewsModal());
    document.getElementById('btn-quick-add-agenda')?.addEventListener('click', () => openAgendaModal());
    document.getElementById('btn-quick-add-team')?.addEventListener('click', () => openTeamModal());

    // Data Loaders
    let globalNews: any[] = [];
    let globalHero: any[] = [];
    let globalAgenda: any[] = [];
    let globalTeam: any[] = [];
    let globalLayanan: any[] = [];
    let globalAbout: any = null;

    async function loadAllData() {
      await Promise.all([fetchNews(), fetchHero(), fetchAgenda(), fetchTeam(), fetchAbout(), fetchLayanan(), fetchAgendaContent()]);
      updateOverviewStats();
    }

    function updateOverviewStats() {
      const newsVal = document.getElementById('stat-news-count');
      const agendaVal = document.getElementById('stat-agenda-count');
      const teamVal = document.getElementById('stat-team-count');
      const layVal = document.getElementById('stat-layanan-count');

      if (newsVal) newsVal.innerText = globalNews.length.toString();
      if (agendaVal) agendaVal.innerText = globalAgenda.length.toString();
      if (teamVal) teamVal.innerText = globalTeam.length.toString();
      if (layVal) layVal.innerText = globalLayanan.length.toString();
    }

    // Table Pagination & Search Engine
    interface TableState {
      search: string;
      perPage: number;
      page: number;
    }

    const stateMap: Record<string, TableState> = {
      hero: { search: '', perPage: 5, page: 1 },
      team: { search: '', perPage: 5, page: 1 },
      agenda: { search: '', perPage: 5, page: 1 },
      news: { search: '', perPage: 5, page: 1 },
      layanan: { search: '', perPage: 5, page: 1 }
    };

    function updatePaginationControls(prefix: string, filteredCount: number, state: TableState, onPageChange: (newPage: number) => void) {
      const totalPages = Math.max(1, Math.ceil(filteredCount / state.perPage));
      if (state.page > totalPages) state.page = totalPages;

      const startIdx = filteredCount === 0 ? 0 : (state.page - 1) * state.perPage + 1;
      const endIdx = Math.min(state.page * state.perPage, filteredCount);

      const infoEl = document.getElementById(`${prefix}-pagination-info`);
      if (infoEl) {
        infoEl.innerText = filteredCount === 0 
          ? `Data tidak ditemukan` 
          : `Menampilkan ${startIdx} - ${endIdx} dari ${filteredCount} data`;
      }

      const controlsEl = document.getElementById(`${prefix}-pagination-controls`);
      if (!controlsEl) return;

      let btnHtml = `<button class="pagination-btn" ${state.page <= 1 ? 'disabled' : ''} id="${prefix}-prev-btn">◄ Prev</button>`;
      
      for (let i = 1; i <= totalPages; i++) {
        btnHtml += `<button class="pagination-btn ${i === state.page ? 'active' : ''}" data-page="${i}">${i}</button>`;
      }

      btnHtml += `<button class="pagination-btn" ${state.page >= totalPages ? 'disabled' : ''} id="${prefix}-next-btn">Next ►</button>`;
      controlsEl.innerHTML = btnHtml;

      controlsEl.querySelectorAll('[data-page]').forEach(b => {
        b.addEventListener('click', (e) => {
          const p = parseInt((e.currentTarget as HTMLElement).getAttribute('data-page') || '1', 10);
          onPageChange(p);
        });
      });

      document.getElementById(`${prefix}-prev-btn`)?.addEventListener('click', () => {
        if (state.page > 1) onPageChange(state.page - 1);
      });

      document.getElementById(`${prefix}-next-btn`)?.addEventListener('click', () => {
        if (state.page < totalPages) onPageChange(state.page + 1);
      });
    }

    function setupTableListeners(prefix: string, state: TableState, renderFn: () => void) {
      const searchInput = document.getElementById(`${prefix}-search`) as HTMLInputElement;
      const perPageSelect = document.getElementById(`${prefix}-per-page`) as HTMLSelectElement;

      searchInput?.addEventListener('input', (e) => {
        state.search = (e.target as HTMLInputElement).value.trim().toLowerCase();
        state.page = 1;
        renderFn();
      });

      perPageSelect?.addEventListener('change', (e) => {
        state.perPage = parseInt((e.target as HTMLSelectElement).value, 10);
        state.page = 1;
        renderFn();
      });
    }

    setupTableListeners('hero', stateMap.hero, () => renderHeroTable());
    setupTableListeners('team', stateMap.team, () => renderTeamTable());
    setupTableListeners('agenda', stateMap.agenda, () => renderAgendaTable());
    setupTableListeners('news', stateMap.news, () => renderNewsTable());
    setupTableListeners('layanan', stateMap.layanan, () => renderLayananTable());

    // 1. NEWS CRUD
    async function fetchNews() {
      const res = await fetch(`/api/news?t=${Date.now()}`, { cache: 'no-store' });
      globalNews = await res.json();
      renderNewsTable();
    }

    function renderNewsTable() {
      const tbody = document.getElementById('news-table-body');
      if (!tbody) return;
      const state = stateMap.news;

      const filtered = globalNews.filter(n => 
        !state.search || 
        n.title?.toLowerCase().includes(state.search) || 
        n.category?.toLowerCase().includes(state.search) || 
        n.excerpt?.toLowerCase().includes(state.search)
      );

      const startIndex = (state.page - 1) * state.perPage;
      const paginated = filtered.slice(startIndex, startIndex + state.perPage);

      if (paginated.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding: 24px; color: #94A3B8;">Tidak ada artikel berita ditemukan.</td></tr>`;
      } else {
        tbody.innerHTML = paginated.map(item => `
          <tr>
            <td><img src="${item.image}" style="width: 56px !important; height: 36px !important; min-width: 56px !important; max-width: 56px !important; max-height: 36px !important; object-fit: cover !important; border-radius: 6px !important; display: block !important;" class="table-thumb" alt="${item.title}" /></td>
            <td><div class="cell-truncate" title="${item.title}"><strong>${item.title}</strong></div></td>
            <td style="white-space:nowrap;">${item.date}</td>
            <td><span class="status-badge diproses">${item.category}</span></td>
            <td style="text-align: right; white-space:nowrap;">
              <button class="action-icon-btn edit-news-btn" data-id="${item.id}">Edit</button>
              <button class="action-icon-btn delete delete-news-btn" data-id="${item.id}">Hapus</button>
            </td>
          </tr>
        `).join('');
      }

      updatePaginationControls('news', filtered.length, state, (p) => {
