---
import type { NewsItem } from '../lib/db';

export interface Props {
  newsList: NewsItem[];
}

const { newsList = [] } = Astro.props;
---

<div id="news-modal" class="modal-backdrop hidden">
  <div class="modal-card">
    <button id="close-news-modal" class="modal-close-btn" aria-label="Tutup modal">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="modal-content-wrap" id="modal-content-wrap">
      <div class="modal-hero">
        <img id="modal-img" src="" alt="" class="modal-banner" />
        <div class="modal-category-badge" id="modal-category">Berita</div>
      </div>
      <div class="modal-body">
        <span class="modal-date" id="modal-date"></span>
        <h2 class="modal-title" id="modal-title"></h2>
        <div class="modal-divider"></div>
        <div class="modal-text" id="modal-text"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(6px);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .modal-backdrop.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-card {
    background: #ffffff;
    width: 100%;
    max-width: 720px;
    max-height: 90vh;
    border-radius: 20px;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    transform: translateY(20px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-backdrop.active .modal-card {
    transform: translateY(0);
  }

  .modal-close-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.65);
    color: #ffffff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 20;
    transition: background 0.2s, color 0.2s;
    backdrop-filter: blur(4px);
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  .modal-close-btn:hover {
    background: var(--primary-red);
  }

  .modal-hero {
    position: relative;
    width: 100%;
    height: 280px;
    background: #0f172a;
  }

  .modal-banner {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .modal-category-badge {
    position: absolute;
    bottom: 16px;
    left: 24px;
    background: var(--primary-red);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 20px;
    letter-spacing: 0.5px;
  }

  .modal-body {
    padding: 28px 32px 40px 32px;
  }

  .modal-date {
    font-size: 0.85rem;
    font-weight: 600;
    color: #64748B;
  }

  .modal-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #0F172A;
    margin: 8px 0 16px 0;
    line-height: 1.3;
    font-family: var(--font-heading);
  }

  .modal-divider {
    height: 3px;
    width: 50px;
    background: var(--primary-red);
    margin-bottom: 20px;
    border-radius: 2px;
  }

  .modal-text {
    font-size: 1rem;
    color: #334155;
    line-height: 1.7;
    white-space: pre-line;
  }

  @media (max-width: 640px) {
    .modal-hero {
      height: 200px;
    }
    .modal-body {
      padding: 20px 20px 30px 20px;
    }
    .modal-title {
      font-size: 1.25rem;
    }
  }
</style>

<script is:inline define:vars={{ newsList }}>
  window.newsData = newsList;

  window.openNewsDetailModal = function(id) {
    const item = window.newsData.find(n => n.id === id);
    if (!item) return;

    document.getElementById('modal-img').src = item.image;
    document.getElementById('modal-category').innerText = item.category || 'Berita';
    document.getElementById('modal-date').innerText = item.date;
    document.getElementById('modal-title').innerText = item.title;
    document.getElementById('modal-text').innerText = item.content || item.excerpt;

    const modal = document.getElementById('news-modal');
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  };

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('news-modal');
    const closeBtn = document.getElementById('close-news-modal');

    closeBtn?.addEventListener('click', () => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  });
</script>
