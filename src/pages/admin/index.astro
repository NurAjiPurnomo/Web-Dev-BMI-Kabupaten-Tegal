    // DYNAMIC PILLARS LIST MANAGER
    let pillarsListState: any[] = [];

    function renderPillarsDynamicList() {
      const container = document.getElementById('pillars-dynamic-list');
      if (!container) return;

      if (pillarsListState.length === 0) {
        container.innerHTML = `<div style="text-align:center; padding: 24px; background: #F8FAFC; border: 1px dashed #CBD5E1; border-radius: 8px; color: #64748B;">Belum ada card pilar gerakan. Klik "+ Tambah Card Pilar Baru" untuk menambah.</div>`;
        return;
      }

      container.innerHTML = pillarsListState.map((item, index) => `
        <div class="pilar-dynamic-item" data-id="${item.id}">
          <div class="pilar-card-header">
            <h5 class="pilar-card-title-tag">
              <span class="pilar-card-num-badge">Pilar #${index + 1}</span>
              <span class="pilar-card-title-text">${item.title ? item.title : 'Card Pilar Baru'}</span>
            </h5>
            <button type="button" class="remove-pilar-btn" data-id="${item.id}">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Hapus Pilar Ini</span>
            </button>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label>Judul Pilar</label>
              <input type="text" class="pilar-input-title" data-id="${item.id}" value="${item.title || ''}" required placeholder="Gotong Royong & Kemanusiaan" />
            </div>
            <div class="form-field">
              <label>Label Kategori</label>
              <input type="text" class="pilar-input-category" data-id="${item.id}" value="${item.category || ''}" required placeholder="Sosial & Kemanusiaan" />
            </div>
          </div>

          <div class="form-field">
            <label>Deskripsi Keterangan Pilar</label>
            <textarea class="pilar-input-desc" data-id="${item.id}" rows="2" required placeholder="Penjelasan aksi nyata pilar...">${item.desc || ''}</textarea>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label>Badge Status</label>
              <input type="text" class="pilar-input-status" data-id="${item.id}" value="${item.status || ''}" required placeholder="Aktif Berkelanjutan" />
            </div>
            <div class="form-field">
              <label>Angka Stats / Jangkauan</label>
              <input type="text" class="pilar-input-stats" data-id="${item.id}" value="${item.stats || ''}" required placeholder="18 Kecamatan" />
            </div>
            <div class="form-field">
              <label>Wilayah Kecamatan</label>
              <input type="text" class="pilar-input-kecamatan" data-id="${item.id}" value="${item.kecamatan || ''}" required placeholder="Seluruh Kab. Tegal" />
            </div>
          </div>

          <div class="form-field">
            <label>URL Gambar Cover Pilar (Upload File atau URL Gambar)</label>
            <div style="display: flex; gap: 8px; align-items: center;">
              <input type="url" class="pilar-input-image" data-id="${item.id}" value="${item.image || ''}" required placeholder="https://images.unsplash.com/..." style="flex: 1;" />
              <label class="btn-upload-file" style="margin: 0;">
                📷 Upload Foto
                <input type="file" class="pilar-file-image" data-id="${item.id}" accept="image/*" style="display: none;" />
              </label>
            </div>
            <div style="margin-top: 8px;">
              <img class="pilar-preview-image" data-id="${item.id}" src="${item.image || ''}" alt="Preview Cover" style="max-height: 90px; border-radius: 8px; border: 1px solid #E2E8F0; ${item.image ? 'display: block;' : 'display: none;'}" />
            </div>
          </div>
        </div>
      `).join('');

      container.querySelectorAll('.remove-pilar-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          pillarsListState = pillarsListState.filter(p => p.id !== id);
          renderPillarsDynamicList();
        });
      });

      container.querySelectorAll('.pilar-file-image').forEach((fileInputEl) => {
        fileInputEl.addEventListener('change', (e) => {
          const input = e.target as HTMLInputElement;
          const id = input.getAttribute('data-id');
          const file = input.files?.[0];
          if (file && id) {
            const reader = new FileReader();
            reader.onload = (event) => {
              const result = event.target?.result as string;
              if (result) {
                const urlInput = container.querySelector(`.pilar-input-image[data-id="${id}"]`) as HTMLInputElement;
                const prevImg = container.querySelector(`.pilar-preview-image[data-id="${id}"]`) as HTMLImageElement;
                if (urlInput) urlInput.value = result;
                if (prevImg) {
                  prevImg.src = result;
                  prevImg.style.display = 'block';
                }
              }
            };
            reader.readAsDataURL(file);
          }
        });
      });

      container.querySelectorAll('.pilar-input-image').forEach((urlInputEl) => {
        urlInputEl.addEventListener('input', (e) => {
          const input = e.target as HTMLInputElement;
          const id = input.getAttribute('data-id');
          const prevImg = container.querySelector(`.pilar-preview-image[data-id="${id}"]`) as HTMLImageElement;
          if (prevImg && id) {
            if (input.value) {
              prevImg.src = input.value;
              prevImg.style.display = 'block';
            } else {
              prevImg.src = '';
              prevImg.style.display = 'none';
            }
          }
        });
      });

      container.querySelectorAll('.pilar-input-title').forEach((titleInputEl) => {
        titleInputEl.addEventListener('input', (e) => {
          const input = e.target as HTMLInputElement;
          const id = input.getAttribute('data-id');
          const itemEl = container.querySelector(`.pilar-dynamic-item[data-id="${id}"]`);
          const titleSpan = itemEl?.querySelector('.pilar-card-title-text');
          if (titleSpan) {
            titleSpan.textContent = input.value || 'Card Pilar Baru';
          }
        });
      });
    }

