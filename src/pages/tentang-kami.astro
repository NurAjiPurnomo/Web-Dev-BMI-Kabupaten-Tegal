---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LayananModal from '../components/LayananModal.astro';
import { fetchSiteSettings, fetchTeamMembers, fetchAboutContent } from '../lib/supabase';

const settings = await fetchSiteSettings();
const rawTeam = await fetchTeamMembers();
const teamMembers = (rawTeam && rawTeam.length > 0) ? rawTeam : [
  {
    id: "team-1",
    name: "H. Bambang Sutrisno, S.T.",
    role: "Ketua DPC BMI Kab. Tegal",
    image: "https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=600&auto=format&fit=crop",
    tag: "Pimpinan Organisasi"
  },
  {
    id: "team-2",
    name: "Rian Hidayat, S.Sos.",
    role: "Sekretaris DPC BMI Kab. Tegal",
    image: "https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?q=80&w=600&auto=format&fit=crop",
    tag: "Keorganisasian"
  },
  {
    id: "team-3",
    name: "Dewi Anggraeni, S.E.",
    role: "Bendahara DPC BMI Kab. Tegal",
    image: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=600&auto=format&fit=crop",
    tag: "Keuangan"
  },
  {
    id: "team-4",
    name: "Ahmad Fauzi, S.Kom.",
    role: "Ketua Bidang UMKM Pemuda",
    image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=600&auto=format&fit=crop",
    tag: "Pemberdayaan UMKM"
  }
];
const aboutContent = await fetchAboutContent();

const kecamatanList = (aboutContent.kecamatanList && aboutContent.kecamatanList.length > 0)
  ? aboutContent.kecamatanList
  : [
      'Slawi', 'Adiwerna', 'Dukuhturi', 'Talang', 'Kramat', 'Suradadi',
      'Warureja', 'Pangkah', 'Lebaksiu', 'Balapulang', 'Margasari', 'Bumijawa',
      'Bojong', 'Jatinegara', 'Pagerbarang', 'Dukuhwaru', 'Kedungbanteng', 'Tarub'
    ];

const programHighlights = [
  {
    title: 'Aksi Tanggap Sosial & Relawan',
    desc: 'Penyaluran bantuan logistik bencana, aksi donor darah, dan bakti sosial gotong royong warga.'
  },
  {
    title: 'Klinik UMKM & Inkubasi Pemuda',
    desc: 'Pendampingan pembuatan legalitas NIB, perbaikan desain kemasan, dan edukasi pemasaran digital gratis.'
  },
  {
    title: 'Partisipasi & Kepemimpinan Pemuda',
    desc: 'Ruang kaderisasi pemuda desa untuk aktif berorganisasi dan berkontribusi dalam pembangunan daerah.'
  }
];
---

<Layout title={`Tentang Kami - ${settings.siteName}`} description="Profil resmi, Visi, Misi, Pilar Gerakan, Jangkauan 18 Kecamatan, dan Pengurus DPC BMI Kabupaten Tegal.">
  <Header siteName={settings.siteName} />

  <main class="about-page-wrapper">
    <!-- Hero Section AI Recruit Pro Style (Light Tech/Corporate Hero Full Viewport) -->
    <section class="about-hero-light">
      <div class="hero-glow-bg"></div>
      <div class="section-container relative-z hero-main-flex-wrapper">
        <div class="hero-split-grid">
          <!-- Left Content -->
          <div class="hero-content-col">
            <span class="sub-heading-pill">PROFIL DPC BANTENG MUDA INDONESIA KAB. TEGAL</span>

            <h1 class="hero-title-light">
              {aboutContent.heroTitle || 'Mewujudkan Pemuda Berdaya Saing, Mandiri & Bergotong Royong'}
            </h1>

            <p class="hero-subtitle-light">
              {aboutContent.heroSubtitle || 'DPC Banteng Muda Indonesia Kabupaten Tegal hadir sebagai wadah aksi nyata kepemudaan dalam penanggulangan bencana, pembinaan wirausaha UMKM desa, dan pelayanan sosial di 18 kecamatan.'}
            </p>

            <div class="hero-cta-group">
              <button id="open-layanan-btn-about-top" class="btn-primary-red">
                <span>Layanan Masyarakat</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
              <a href="/program" class="btn-secondary-outline">
                <span>Lihat Agenda Kerja</span>
              </a>
            </div>

            <div class="hero-trust-bullets">
              <div class="trust-bullet-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Aktif di 18 Kecamatan</span>
              </div>
              <div class="trust-bullet-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Pendampingan Legalitas UMKM</span>
              </div>
              <div class="trust-bullet-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Tanggap Bencana & Relawan</span>
              </div>
            </div>
          </div>

          <!-- Right Mascot Column -->
          <div class="hero-video-col">
            <div class="video-card-container">
              <video 
                class="hero-video-player"
                autoplay
                muted
                playsinline
              >
                <source src="/videos/1002.mp4" type="video/mp4" />
              </video>
            </div>
          </div>
        </div>
      </div>

      <!-- Seksi Statistik Rekam Jejak (Metric Cards - Bottom Fold) -->
      <div class="metrics-section">
        <div class="section-container">
          <div class="metrics-grid">
            <div class="metric-card">
              <div class="metric-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <div class="metric-text-group">
                <div class="metric-val">{aboutContent.metric1Val || '18'}</div>
                <div class="metric-lbl">{aboutContent.metric1Lbl || 'Kecamatan Terjangkau'}</div>
              </div>
            </div>

            <div class="metric-card">
              <div class="metric-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              </div>
              <div class="metric-text-group">
                <div class="metric-val">{aboutContent.metric2Val || '150+'}</div>
                <div class="metric-lbl">{aboutContent.metric2Lbl || 'Aksi Sosial & Relawan'}</div>
              </div>
            </div>

            <div class="metric-card">
              <div class="metric-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
              </div>
              <div class="metric-text-group">
                <div class="metric-val">{aboutContent.metric3Val || '350+'}</div>
                <div class="metric-lbl">{aboutContent.metric3Lbl || 'UMKM Binaan Pemuda'}</div>
              </div>
            </div>

            <div class="metric-card">
              <div class="metric-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              </div>
              <div class="metric-text-group">
                <div class="metric-val">{aboutContent.metric4Val || '10.000+'}</div>
                <div class="metric-lbl">{aboutContent.metric4Lbl || 'Penerima Bantuan'}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Seksi Profil Utama Organisasi -->
    <section class="content-section bg-white" id="profil-utama">
      <div class="section-container grid-2-col">
        <div class="text-block">
          <span class="sub-heading-pill">{aboutContent.sejarahTag || 'PERAN & SEJARAH'}</span>
          <h2 class="section-heading">
            {aboutContent.sejarahTitle || 'Gerakan Pemuda Berjiwa Social Impact & Gotong Royong'}
          </h2>

          <p class="lead-text">
            {aboutContent.sejarahLead || 'DPC BMI Kabupaten Tegal merupakan wadah kepemudaan yang berdiri di atas semangat gotong royong dan kepedulian sosial untuk bergerak bersama masyarakat.'}
          </p>
          <p class="body-text">
            {aboutContent.sejarahBody || 'Kami hadir melayani warga di 18 kecamatan — dari kawasan pesisir Suradadi hingga lereng Bumijawa — melalui aksi relawan bencana, bakti sosial, donor darah, hingga pendampingan izin legalitas NIB dan pemasaran digital bagi UMKM pemuda desa.'}
          </p>

          <div class="highlights-list">
            <div class="highlight-item">
              <div class="item-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <h4 class="item-title">{aboutContent.highlight1Title || 'Aksi Tanggap Sosial & Relawan'}</h4>
                <p class="item-desc">{aboutContent.highlight1Desc || 'Penyaluran bantuan logistik bencana, aksi donor darah, dan bakti sosial gotong royong warga.'}</p>
              </div>
            </div>

            <div class="highlight-item">
              <div class="item-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <h4 class="item-title">{aboutContent.highlight2Title || 'Klinik UMKM & Inkubasi Pemuda'}</h4>
                <p class="item-desc">{aboutContent.highlight2Desc || 'Pendampingan pembuatan legalitas NIB, perbaikan desain kemasan, dan edukasi pemasaran digital gratis.'}</p>
              </div>
            </div>

            <div class="highlight-item">
              <div class="item-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div>
                <h4 class="item-title">{aboutContent.highlight3Title || 'Partisipasi & Kepemimpinan Pemuda'}</h4>
                <p class="item-desc">{aboutContent.highlight3Desc || 'Ruang kaderisasi pemuda desa untuk aktif berorganisasi dan berkontribusi dalam pembangunan daerah.'}</p>
              </div>
            </div>
          </div>
        </div>

        <div class="img-block">
          <div class="visual-card-wrapper">
            <img src={aboutContent.sejarahImage || "https://images.unsplash.com/photo-1559027615-cd4628902d4a?q=80&w=800&auto=format&fit=crop"} alt="Relawan Pemuda BMI Kabupaten Tegal" class="about-hero-img" />
            
            <div class="floating-stat-badge">
              <div class="badge-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              </div>
              <div class="badge-text">
                <span class="stat-big">{aboutContent.sejarahBadgeText || '18 Kecamatan'}</span>
                <span class="stat-sub">{aboutContent.sejarahBadgeSub || 'Jaringan Relawan & Pengurus'}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Seksi 2: Visi & Misi (Cards Style AI Recruit Pro) -->
    <section class="content-section bg-light" id="visi-misi">
      <div class="section-container">
        <div class="title-wrapper text-center">
          <h2 class="section-title">
            Visi & Misi Organisasi
          </h2>
          <p class="section-desc-center">Komitmen utama gerakan pemuda BMI Kabupaten Tegal untuk kemajuan daerah.</p>
        </div>

        <div class="visi-misi-grid">
          <!-- Card Visi -->
          <div class="info-card">
            <div class="icon-box">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <circle cx="12" cy="12" r="2"></circle>
              </svg>
            </div>
            <h3 class="card-title">Visi Utama</h3>
            <p class="card-desc">
              Mewujudkan generasi muda Kabupaten Tegal yang mandiri, berkarakter gotong royong, berdaya saing tinggi dalam ekonomi kreatif UMKM, serta peduli terhadap kesejahteraan sosial masyarakat.
            </p>

            <div class="batik-corner" title="BMI Tegal Cultural Accent">
              <svg viewBox="0 0 80 80" class="batik-svg">
                <path d="M80 0 L80 80 L0 80 Z" fill="var(--dark-red)" />
                <path d="M80 20 L20 80 M80 40 L40 80 M80 60 L60 80" stroke="var(--primary-red)" stroke-width="3" opacity="0.6" />
                <circle cx="65" cy="65" r="4" fill="#E2E8F0" opacity="0.8"/>
              </svg>
            </div>
          </div>

          <!-- Card Misi -->
          <div class="info-card">
            <div class="icon-box">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 11 12 14 22 4"></polyline>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
              </svg>
            </div>
            <h3 class="card-title">Misi Strategis</h3>
            <ul class="misi-list">
              <li>Menerjunkan tim relawan dalam setiap aksi sosial dan penanggulangan bencana di Kabupaten Tegal.</li>
              <li>Menyelenggarakan pelatihan dan pendampingan UMKM bagi wirausahawan pemuda desa.</li>
              <li>Memperkuat sinergi antara generasi muda dengan tokoh masyarakat dan pemerintah daerah.</li>
              <li>Mendorong partisipasi aktif pemuda dalam kegiatan kemasyarakatan dan kepemimpinan.</li>
            </ul>

            <div class="batik-corner" title="BMI Tegal Cultural Accent">
              <svg viewBox="0 0 80 80" class="batik-svg">
                <path d="M80 0 L80 80 L0 80 Z" fill="var(--dark-red)" />
                <path d="M80 20 L20 80 M80 40 L40 80 M80 60 L60 80" stroke="var(--primary-red)" stroke-width="3" opacity="0.6" />
                <circle cx="65" cy="65" r="4" fill="#E2E8F0" opacity="0.8"/>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Seksi 3: Pilar Gerakan BMI -->
    <section class="content-section bg-white" id="pilar-gerakan">
      <div class="section-container">
        <div class="title-wrapper text-center">
          <h2 class="section-title">
            Pilar Gerakan Pemuda
          </h2>
          <p class="section-desc-center">Nilai-nilai utama yang menjiwai seluruh aksi sosial dan pembinaan pemuda.</p>
        </div>

        <div class="pilars-grid">
          <div class="pilar-card">
            <div class="pilar-svg-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h4>{aboutContent.pilar1Title || 'Gotong Royong'}</h4>
            <p>{aboutContent.pilar1Desc || 'Bahu-membahu bersama warga tanpa membedakan latar belakang demi kemajuan daerah.'}</p>
          </div>

          <div class="pilar-card">
            <div class="pilar-svg-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
            </div>
            <h4>{aboutContent.pilar2Title || 'Pemberdayaan UMKM'}</h4>
            <p>{aboutContent.pilar2Desc || 'Mendampingi wirausaha muda dari perizinan legalitas hingga strategi pemasaran digital.'}</p>
          </div>

          <div class="pilar-card">
            <div class="pilar-svg-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h4>{aboutContent.pilar3Title || 'Tanggap Bencana'}</h4>
            <p>{aboutContent.pilar3Desc || 'Sigap dan cepat hadir membantu warga terdampak musibah banjir dan krisis sosial.'}</p>
          </div>

          <div class="pilar-card">
            <div class="pilar-svg-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
            <h4>{aboutContent.pilar4Title || 'Kemandirian Pemuda'}</h4>
            <p>{aboutContent.pilar4Desc || 'Membentuk karakter pemuda yang berani berkarya, berorientasi solusi, dan inovatif.'}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Seksi 4: Jangkauan 18 Kecamatan -->
    <section class="content-section bg-light">
      <div class="section-container">
        <div class="title-wrapper text-center">
          <h2 class="section-title">
            Jangkauan 18 Kecamatan
          </h2>
          <p class="section-desc-center">{aboutContent.kecamatanDesc || 'Jaringan pengurus dan relawan BMI tersebar merata di seluruh wilayah Kabupaten Tegal.'}</p>
        </div>

        <div class="kecamatan-badge-grid">
          {kecamatanList.map((item) => (
            <div class="kc-chip">
              <span class="kc-dot"></span>
              <span>Kec. {item}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Seksi 5: Pengurus DPC BMI Kab. Tegal -->
    <section class="content-section bg-white" id="pengurus">
      <div class="section-container">
        <div class="title-wrapper text-center">
          <h2 class="section-title">
            Pengurus DPC BMI Kab. Tegal
          </h2>
          <p class="section-desc-center">Tim kepemimpinan organisasi Banteng Muda Indonesia Kabupaten Tegal.</p>
        </div>

        <div class="team-grid">
          {teamMembers.map((member) => (
            <div class="team-card">
              <div class="team-img-wrap">
                <img src={member.image} alt={member.name} class="team-img" />
                <span class="team-tag">{member.tag}</span>
              </div>
              <div class="team-body">
                <h4 class="team-name">{member.name}</h4>
                <p class="team-role">{member.role}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Seksi 6: Lokasi Sekretariat & Kontak Kantor DPC BMI Kab. Tegal -->
    <section class="content-section bg-light" id="lokasi-kantor">
      <div class="section-container">
        <div class="title-wrapper text-center">
          <h2 class="section-title">
            {aboutContent.kantorTitle || 'Lokasi Kantor & Sekretariat'}
          </h2>
          <p class="section-desc-center">{aboutContent.kantorSub || 'Kantor DPC Banteng Muda Indonesia Kabupaten Tegal terbuka untuk ruang aspirasi, konsultasi wirausaha, dan layanan masyarakat.'}</p>
        </div>

        <div class="office-location-grid">
          <!-- Left Column: Detailed Office Info Card -->
          <div class="office-info-card">
            <div class="office-card-header">
              <div class="office-badge">KANTOR SEKRETARIAT DPC</div>
              <h3 class="office-name">{settings.siteName}</h3>
            </div>

            <div class="office-details-stack">
              <div class="office-detail-item">
                <div class="detail-icon-box">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                </div>
                <div class="detail-content">
                  <span class="detail-label">Alamat Kantor Resmi</span>
                  <p class="detail-val">{aboutContent.kantorAlamat || settings.address}</p>
                </div>
              </div>

              <div class="office-detail-item">
                <div class="detail-icon-box">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                </div>
                <div class="detail-content">
                  <span class="detail-label">Jam Operasional Layanan</span>
                  <p class="detail-val">{aboutContent.kantorJam || 'Senin - Sabtu: 08.00 - 16.00 WIB (Hari Minggu / Libur Nasional Tutup)'}</p>
                </div>
              </div>

              <div class="office-detail-item">
                <div class="detail-icon-box">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                </div>
                <div class="detail-content">
                  <span class="detail-label">Layanan Telepon / WhatsApp</span>
                  <p class="detail-val">{aboutContent.kantorPhone || settings.phone}</p>
                </div>
