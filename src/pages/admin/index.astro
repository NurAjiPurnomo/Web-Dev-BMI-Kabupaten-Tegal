---
import Layout from '../../layouts/Layout.astro';
import { getDB } from '../../lib/db';

const db = getDB();
---

<Layout title="CMS Admin Dashboard - BMI Kabupaten Tegal">
  <div id="admin-app" class="admin-layout">
    <!-- Login Screen -->
    <div id="login-screen" class="login-container">
      <div class="login-card animate-fade-in">
        <div class="login-brand">
          <div class="logo-circle">
            <img src="/logo-bmi..png" alt="Logo Banteng Muda Indonesia" class="admin-logo-img" />
          </div>
          <h1>Dashboard Admin</h1>
          <p>Sistem Informasi & CMS BMI Kabupaten Tegal</p>
        </div>

        <form id="login-form" class="login-form">
          <div class="form-field">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" placeholder="Contoh: nama@gmail.com" required autocomplete="username" />
          </div>
          <div class="form-field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password" />
          </div>

          <div id="login-alert" class="alert-box hidden"></div>

          <button type="submit" class="btn-primary-admin">
            Masuk ke Dashboard
          </button>
        </form>

        <div style="text-align: center; margin-top: 20px;">
          <a href="/" class="back-link">Kembali ke Website Publik</a>
        </div>
      </div>
    </div>

    <!-- Mobile Sidebar Backdrop Overlay -->
    <div id="admin-sidebar-backdrop" class="admin-sidebar-backdrop hidden"></div>

    <!-- Main Dashboard Panel -->
    <div id="dashboard-panel" class="dashboard-container hidden">
      <!-- Admin Sidebar -->
      <aside class="admin-sidebar">
        <div class="sidebar-header">
          <div class="sidebar-logo">
            <div class="mini-logo-wrapper">
              <img src="/logo-bmi..png" alt="Logo BMI" class="sidebar-logo-img" />
            </div>
            <div class="sidebar-brand-info">
              <span class="logo-text">CMS Admin Panel</span>
              <span class="logo-subtext">BMI Kabupaten Tegal</span>
            </div>
          </div>

          <!-- Mobile Hamburger Toggle Button -->
          <button id="admin-mobile-toggle" class="admin-mobile-toggle-btn" aria-label="Menu Admin">
            <svg class="hamburger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            <svg class="close-icon hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <nav class="sidebar-nav">
          <button class="nav-item active" data-tab="overview">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            <span>Ringkasan Dashboard</span>
          </button>

          <button class="nav-item" data-tab="hero">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span>Halaman Beranda</span>
          </button>

          <button class="nav-item" data-tab="about">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <span>Halaman Tentang Kami</span>
          </button>

          <button class="nav-item" data-tab="agenda">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <span>Halaman Agenda Kerja</span>
          </button>

          <button class="nav-item" data-tab="news">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="14 4 14 9 19 9"></polyline></svg>
            <span>Halaman Berita</span>
          </button>

          <button class="nav-item" data-tab="layanan">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            <span>Layanan Warga</span>
            <span class="badge-count" id="layanan-badge-count" style={db.layanan.filter(l => l.status === 'Baru').length === 0 ? "display: none;" : ""}>{db.layanan.filter(l => l.status === 'Baru').length}</span>
          </button>

          <button class="nav-item" data-tab="settings">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Pengaturan Situs</span>
          </button>
        </nav>

        <div class="sidebar-footer">
          <a href="/" target="_blank" class="btn-live-view">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            <span>Lihat Website Utama</span>
          </a>
          <button id="logout-btn" class="btn-logout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>Keluar</span>
          </button>
        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="admin-main">
        <!-- Top Bar -->
        <header class="top-bar">
          <div>
            <span class="top-bar-sub">SISTEM KELOLA KONTEN (CMS)</span>
            <h2 id="tab-title">Ringkasan Dashboard</h2>
          </div>
        </header>

        <div class="content-body">
          <!-- TAB 1: OVERVIEW -->
          <section id="tab-overview" class="tab-content active">
            <div class="stats-grid">
              <div class="stat-card">
                <div class="stat-icon red">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 20H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h10l5 5v11a2 2 0 0 1-2 2z"></path></svg>
                </div>
                <div class="stat-data">
                  <span class="stat-val" id="stat-news-count">{db.news.length}</span>
                  <span class="stat-lbl">Artikel Berita Active</span>
                </div>
              </div>

              <div class="stat-card">
                <div class="stat-icon dark">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                </div>
                <div class="stat-data">
                  <span class="stat-val" id="stat-agenda-count">{db.agenda.length}</span>
                  <span class="stat-lbl">Agenda Kerja Terjadwal</span>
                </div>
              </div>

              <div class="stat-card">
                <div class="stat-icon orange">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                </div>
                <div class="stat-data">
                  <span class="stat-val" id="stat-team-count">{db.team.length}</span>
                  <span class="stat-lbl">Pengurus DPC Terdaftar</span>
                </div>
              </div>

              <div class="stat-card">
                <div class="stat-icon red">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                </div>
                <div class="stat-data">
                  <span class="stat-val" id="stat-layanan-count">{db.layanan.length}</span>
                  <span class="stat-lbl">Permohonan Warga</span>
                </div>
              </div>
            </div>

            <div class="quick-actions-panel">
              <h3>Aksi Pintar Pengelola Konten</h3>
              <div class="action-buttons-group">
                <button class="btn-action-card" id="btn-quick-add-news">
                  <span class="icon">+</span>
                  <span>Tambah Berita Baru</span>
                </button>
                <button class="btn-action-card" id="btn-quick-add-agenda">
                  <span class="icon">+</span>
                  <span>Tambah Agenda Kerja</span>
                </button>
                <button class="btn-action-card" id="btn-quick-add-team">
                  <span class="icon">+</span>
                  <span>Tambah Pengurus DPC</span>
                </button>
              </div>
            </div>
          </section>

          <!-- TAB 2: HALAMAN BERANDA (HERO SLIDER) -->
          <section id="tab-hero" class="tab-content">
            <div class="section-actions-bar">
              <div>
                <h3 class="tab-sec-title">Kelola Slide Banner Hero Beranda</h3>
                <p class="tab-sec-desc">Atur foto background, judul utama, dan subtitle pada slider beranda depan.</p>
              </div>
              <button class="btn-add-new" id="open-add-hero-modal">
                + Tambah Slide Banner
              </button>
            </div>
            
            <div class="table-card">
              <div class="table-toolbar">
                <div class="search-box">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                  <input type="text" id="hero-search" class="table-search-input" placeholder="Cari judul slide..." />
                </div>
                <div class="table-toolbar-right">
                  <select id="hero-per-page" class="table-select-perpage">
                    <option value="5" selected>5 per halaman</option>
                    <option value="10">10 per halaman</option>
                    <option value="25">25 per halaman</option>
                  </select>
                </div>
              </div>
              <div class="table-container">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th style="width: 80px;">Preview</th>
                      <th>Judul Banner</th>
                      <th>Sub-Judul</th>
                      <th style="width: 100px;">Status</th>
                      <th style="width: 130px; text-align: right;">Aksi</th>
                    </tr>
                  </thead>
                  <tbody id="hero-table-body">
                    <!-- Rendered dynamically -->
                  </tbody>
                </table>
              </div>
              <div class="table-pagination-bar">
                <span class="pagination-info" id="hero-pagination-info">Menampilkan 0 data</span>
                <div class="pagination-controls" id="hero-pagination-controls"></div>
              </div>
            </div>
          </section>

          <!-- TAB 3: HALAMAN TENTANG KAMI -->
          <section id="tab-about" class="tab-content">
            <!-- Sub-Tab 1: Profil & Visi Misi -->
            <form id="about-form" class="settings-form-panel">
              <div class="form-section">
                <h4>1. Teks Banner Hero & Profil Utama</h4>
                <div class="form-field">
                  <label>Judul Utama Hero (Tentang Kami)</label>
                  <input type="text" id="about-heroTitle" required />
                </div>
                <div class="form-field">
                  <label>Sub-Judul Hero / Deskripsi Ringkas</label>
                  <textarea id="about-heroSubtitle" rows="2" required></textarea>
                </div>
              </div>

              <div class="form-section">
                <h4>2. Rekam Jejak & 4 Kartu Statistik (Metrics)</h4>
                <div class="form-row">
                  <div class="form-field">
                    <label>Angka Stat 1</label>
                    <input type="text" id="about-metric1Val" required placeholder="Contoh: 18" />
                  </div>
                  <div class="form-field">
                    <label>Label Stat 1</label>
                    <input type="text" id="about-metric1Lbl" required placeholder="Contoh: Kecamatan Terjangkau" />
                  </div>
                  <div class="form-field">
                    <label>Angka Stat 2</label>
                    <input type="text" id="about-metric2Val" required placeholder="Contoh: 150+" />
                  </div>
                  <div class="form-field">
                    <label>Label Stat 2</label>
                    <input type="text" id="about-metric2Lbl" required placeholder="Contoh: Aksi Sosial & Relawan" />
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-field">
                    <label>Angka Stat 3</label>
                    <input type="text" id="about-metric3Val" required placeholder="Contoh: 350+" />
                  </div>
                  <div class="form-field">
                    <label>Label Stat 3</label>
                    <input type="text" id="about-metric3Lbl" required placeholder="Contoh: UMKM Binaan Pemuda" />
                  </div>
                  <div class="form-field">
                    <label>Angka Stat 4</label>
                    <input type="text" id="about-metric4Val" required placeholder="Contoh: 10.000+" />
                  </div>
                  <div class="form-field">
                    <label>Label Stat 4</label>
                    <input type="text" id="about-metric4Lbl" required placeholder="Contoh: Penerima Bantuan" />
                  </div>
                </div>
              </div>

              <div class="form-section">
                <h4>3. Seksi Peran & Sejarah Organisasi</h4>
                <div class="form-row">
                  <div class="form-field">
                    <label>Tag Sub-Heading Seksi</label>
                    <input type="text" id="about-sejarahTag" required placeholder="Contoh: PERAN & SEJARAH" />
                  </div>
                  <div class="form-field">
                    <label>Judul Seksi Peran & Sejarah</label>
                    <input type="text" id="about-sejarahTitle" required placeholder="Contoh: Gerakan Pemuda Berjiwa Social Impact..." />
                  </div>
                </div>
                <div class="form-field">
                  <label>Paragraf Lead (Teks Tebal / Ringkasan)</label>
                  <textarea id="about-sejarahLead" rows="2" required></textarea>
                </div>
                <div class="form-field">
                  <label>Paragraf Deskripsi Penjelasan Lengkap</label>
                  <textarea id="about-sejarahBody" rows="3" required></textarea>
                </div>
                <div class="form-row">
                  <div class="form-field" style="flex: 2;">
                    <label>Foto Seksi Sejarah (Upload File atau URL Gambar)</label>
                    <div style="display: flex; gap: 8px; align-items: center;">
                      <input type="url" id="about-sejarahImage" required placeholder="https://images.unsplash.com/..." style="flex: 1;" />
                      <label class="btn-upload-file">
                        📷 Upload Foto
                        <input type="file" id="about-sejarahImage-file" accept="image/*" style="display: none;" />
                      </label>
                    </div>
                    <div style="margin-top: 8px;">
                      <img id="about-sejarahImage-preview" src="" alt="Preview Foto Sejarah" style="max-height: 90px; border-radius: 8px; border: 1px solid #E2E8F0; display: none;" />
                    </div>
                  </div>
                  <div class="form-field">
                    <label>Teks Badge Melayang (Angka)</label>
                    <input type="text" id="about-sejarahBadgeText" required placeholder="Contoh: 18 Kecamatan" />
                  </div>
                  <div class="form-field">
                    <label>Sub-Teks Badge Melayang</label>
                    <input type="text" id="about-sejarahBadgeSub" required placeholder="Contoh: Jaringan Relawan & Pengurus" />
                  </div>
                </div>
              </div>

              <div class="form-section">
                <h4>4. 3 Poin Unggulan Program Kerja</h4>
                <div class="form-row">
                  <div class="form-field">
                    <label>Judul Poin Unggulan 1</label>
                    <input type="text" id="about-highlight1Title" required />
                  </div>
                  <div class="form-field">
                    <label>Deskripsi Poin 1</label>
                    <input type="text" id="about-highlight1Desc" required />
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-field">
                    <label>Judul Poin Unggulan 2</label>
                    <input type="text" id="about-highlight2Title" required />
                  </div>
                  <div class="form-field">
                    <label>Deskripsi Poin 2</label>
                    <input type="text" id="about-highlight2Desc" required />
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-field">
                    <label>Judul Poin Unggulan 3</label>
                    <input type="text" id="about-highlight3Title" required />
                  </div>
                  <div class="form-field">
                    <label>Deskripsi Poin 3</label>
                    <input type="text" id="about-highlight3Desc" required />
                  </div>
                </div>
              </div>

              <div class="form-section">
                <h4>5. Seksi Visi & Misi Organisasi</h4>
                <div class="form-field">
                  <label>Judul Visi Organisasi</label>
                  <input type="text" id="about-visiTitle" required />
                </div>
                <div class="form-field">
                  <label>Deskripsi Visi Utama</label>
                  <textarea id="about-visiDesc" rows="3" required></textarea>
                </div>
              </div>

              <div class="form-section">
                <h4>6. 4 Pilar Gerakan Pemuda</h4>
                <div class="form-row">
                  <div class="form-field">
                    <label>Judul Pilar 1</label>
                    <input type="text" id="about-pilar1Title" required placeholder="Gotong Royong" />
                  </div>
                  <div class="form-field">
                    <label>Deskripsi Pilar 1</label>
                    <input type="text" id="about-pilar1Desc" required />
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-field">
                    <label>Judul Pilar 2</label>
                    <input type="text" id="about-pilar2Title" required placeholder="Pemberdayaan UMKM" />
                  </div>
                  <div class="form-field">
                    <label>Deskripsi Pilar 2</label>
                    <input type="text" id="about-pilar2Desc" required />
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-field">
                    <label>Judul Pilar 3</label>
                    <input type="text" id="about-pilar3Title" required placeholder="Tanggap Bencana" />
                  </div>
                  <div class="form-field">
                    <label>Deskripsi Pilar 3</label>
                    <input type="text" id="about-pilar3Desc" required />
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-field">
                    <label>Judul Pilar 4</label>
                    <input type="text" id="about-pilar4Title" required placeholder="Kemandirian Pemuda" />
                  </div>
                  <div class="form-field">
                    <label>Deskripsi Pilar 4</label>
                    <input type="text" id="about-pilar4Desc" required />
                  </div>
                </div>
              </div>

              <div class="form-section">
                <h4>7. Jangkauan 18 Kecamatan</h4>
                <div class="form-field">
                  <label>Deskripsi Keterangan Jangkauan Kecamatan</label>
                  <input type="text" id="about-kecamatanDesc" required />
                </div>
                <div class="form-field" style="margin-top: 14px;">
                  <label>Daftar 18 Nama Kecamatan (Dipisahkan dengan koma)</label>
                  <textarea id="about-kecamatanListText" rows="3" placeholder="Slawi, Adiwerna, Dukuhturi, Talang, Kramat, Suradadi, Warureja, Pangkah, Lebaksiu, Balapulang, Margasari, Bumijawa, Bojong, Jatinegara, Pagerbarang, Dukuhwaru, Kedungbanteng, Tarub" required></textarea>
                  <small style="color: #64748B; font-size: 0.78rem; margin-top: 4px; display: block;">Perubahan nama kecamatan di atas akan langsung memperbarui chip badge 18 Kecamatan di halaman publik.</small>
                </div>
              </div>

              <div class="form-section">
                <h4>8. Seksi Lokasi Kantor & Sekretariat</h4>
                <div class="form-row">
                  <div class="form-field">
                    <label>Judul Seksi Lokasi</label>
                    <input type="text" id="about-kantorTitle" required />
                  </div>
                  <div class="form-field">
                    <label>Sub-Judul Seksi Lokasi</label>
                    <input type="text" id="about-kantorSub" required />
                  </div>
                </div>
                <div class="form-field">
                  <label>Alamat Kantor Resmi</label>
                  <input type="text" id="about-kantorAlamat" required />
                </div>
                <div class="form-row">
                  <div class="form-field">
                    <label>Jam Operasional Layanan</label>
                    <input type="text" id="about-kantorJam" required />
                  </div>
                  <div class="form-field">
                    <label>Telepon / WhatsApp Humas</label>
                    <input type="text" id="about-kantorPhone" required />
                  </div>
                  <div class="form-field">
                    <label>Email Resmi Kontak</label>
                    <input type="text" id="about-kantorEmail" required />
                  </div>
                </div>
                <div class="form-field">
                  <label>URL Petunjuk Arah Google Maps</label>
                  <input type="url" id="about-kantorMapsUrl" required />
                </div>
              </div>

              <div class="form-section">
                <h4>9. Banner CTA Aksi Melayani Warga</h4>
