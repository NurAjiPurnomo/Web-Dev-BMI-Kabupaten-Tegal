    function bindImageUploader(urlInputId: string, fileInputId: string, previewImgId: string) {
      const urlInput = document.getElementById(urlInputId) as HTMLInputElement;
      const fileInput = document.getElementById(fileInputId) as HTMLInputElement;
      const previewImg = document.getElementById(previewImgId) as HTMLImageElement;

      if (!urlInput) return;

      function updatePreview(src: string) {
        if (previewImg) {
          if (src) {
            previewImg.src = src;
            previewImg.style.display = 'block';
          } else {
            previewImg.src = '';
            previewImg.style.display = 'none';
          }
        }
      }

      urlInput.addEventListener('input', () => updatePreview(urlInput.value));

      fileInput?.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (e) => {
            const result = e.target?.result as string;
            if (result) {
              urlInput.value = result;
              updatePreview(result);
            }
          };
          reader.readAsDataURL(file);
        }
      });
    }

    bindImageUploader('about-sejarahImage', 'about-sejarahImage-file', 'about-sejarahImage-preview');
    bindImageUploader('news-form-image', 'news-form-image-file', 'news-form-image-preview');
    bindImageUploader('hero-form-image', 'hero-form-image-file', 'hero-form-image-preview');
    bindImageUploader('team-form-image', 'team-form-image-file', 'team-form-image-preview');
