        </div>
        <div class="form-row">
          <div class="form-field">
            <label>Tanggal Pelaksanaan *</label>
            <input type="text" id="agenda-form-date" required placeholder="Contoh: Sabtu, 12 Oktober 2026" />
          </div>
          <div class="form-field">
            <label>Jam / Waktu Pelaksanaan (Opsional)</label>
            <input type="text" id="agenda-form-time" placeholder="Contoh: 09.00 WIB atau 08.00 - 12.00 WIB" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label>Dampak / Target Result *</label>
            <input type="text" id="agenda-form-impact" required placeholder="Contoh: 100+ Izin NIB Terbit" />
          </div>
          <div class="form-field">
            <label>Lokasi Spesifik</label>
            <input type="text" id="agenda-form-location" placeholder="Contoh: Pendopo Kecamatan Slawi" />
          </div>
        </div>
        <div class="form-field">
          <label>Deskripsi Penjelasan Program *</label>
          <textarea id="agenda-form-desc" rows="3" required placeholder="Penjelasan rincian kegiatan..."></textarea>
        </div>
        <button type="submit" class="btn-primary-admin" style="margin-top: 12px;">Simpan Agenda Kerja</button>
      </form>
    </div>
  </div>

  <!-- MODAL EDIT/ADD PENGURUS DPC -->
  <div id="team-editor-modal" class="admin-modal-backdrop hidden">
    <div class="admin-modal-card">
      <button class="close-admin-modal" id="close-team-editor">&times;</button>
      <h3 id="team-editor-title">Tambah Pengurus DPC</h3>
      <form id="team-editor-form">
        <input type="hidden" id="edit-team-id" />
        <div class="form-field">
          <label>Nama Lengkap & Gelar *</label>
          <input type="text" id="team-form-name" required placeholder="Contoh: H. Bambang Sutrisno, S.T." />
        </div>
        <div class="form-row">
          <div class="form-field">
            <label>Jabatan Organisasi *</label>
            <input type="text" id="team-form-role" required placeholder="Contoh: Ketua DPC BMI Kab. Tegal" />
          </div>
          <div class="form-field">
            <label>Tag Bidang *</label>
            <input type="text" id="team-form-tag" required placeholder="Contoh: Pimpinan Organisasi / Keuangan" />
          </div>
        </div>
        <div class="form-field">
          <label>Foto Profil Pengurus (Upload File atau URL) *</label>
          <div style="display: flex; gap: 8px; align-items: center;">
            <input type="url" id="team-form-image" required placeholder="https://images.unsplash.com/..." style="flex: 1;" />
            <label class="btn-upload-file">
              📷 Upload Foto
              <input type="file" id="team-form-image-file" accept="image/*" style="display: none;" />
            </label>
          </div>
          <img id="team-form-image-preview" src="" alt="Preview Profil" style="max-height: 80px; width: 80px; height: 80px; border-radius: 50%; object-fit: cover; margin-top: 8px; border: 1px solid #E2E8F0; display: none;" />
        </div>
        <button type="submit" class="btn-primary-admin" style="margin-top: 12px;">Simpan Pengurus</button>
      </form>
    </div>
  </div>

  <!-- MODAL VIEW LAYANAN DETAIL -->
  <div id="layanan-detail-modal" class="admin-modal-backdrop hidden">
    <div class="admin-modal-card">
      <button class="close-admin-modal" id="close-layanan-detail">&times;</button>
      <h3>Detail Permohonan Layanan</h3>
      <div class="layanan-detail-body" id="layanan-detail-content"></div>
    </div>
  </div>
</Layout>

<style>
