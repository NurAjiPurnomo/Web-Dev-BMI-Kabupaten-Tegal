{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/agenda/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/agenda-content/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/hero/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/layanan/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/news/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/settings/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/team/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/upload/?$",
			"dest": "_render"
		},
		{
			"src": "^/berita/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/berita/?$",
			"dest": "_render"
		},
		{
			"src": "^/program/?$",
			"dest": "_render"
		},
		{
			"src": "^/tentang-kami/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}