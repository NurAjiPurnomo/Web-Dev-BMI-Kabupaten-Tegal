---
import type { SiteSettings } from '../lib/db';

export interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;

const rawPhone = settings.phone || "0888-8888-8888";
const emailAddr = settings.email || "humas@bmiltegal.or.id";
---

<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-container">
      <!-- Column 1: Organization Identity -->
      <div class="footer-col col-brand">
        <a href="/" class="footer-logo">
          <img src="/logo-bmi..png" alt="Logo Banteng Muda Indonesia" class="footer-logo-img" />
          <div class="footer-logo-divider"></div>
          <div class="footer-brand-text">
            <span class="footer-brand-line">BANTENG</span>
            <span class="footer-brand-line">MUDA</span>
            <span class="footer-brand-line">INDONESIA</span>
            <span class="footer-brand-region">KABUPATEN TEGAL</span>
          </div>
        </a>
        <p class="footer-desc">
          {settings.description || "Barisan Muda Indonesia DPC Kabupaten Tegal — Wadah gerakan kepemudaan yang berfokus pada aksi sosial, pemberdayaan UMKM, dan pengabdian masyarakat."}
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="footer-col col-nav">
        <h4 class="col-title">Navigasi Utama</h4>
        <nav class="footer-nav-menu">
          <a href="/" class="f-link">
            <span class="f-link-arrow">›</span>
            <span>Beranda</span>
          </a>
          <a href="/tentang-kami" class="f-link">
            <span class="f-link-arrow">›</span>
            <span>Tentang Kami</span>
          </a>
          <a href="/program" class="f-link">
            <span class="f-link-arrow">›</span>
            <span>Agenda Kerja</span>
          </a>
          <a href="/berita" class="f-link">
            <span class="f-link-arrow">›</span>
            <span>Berita & Kegiatan</span>
          </a>
        </nav>
      </div>

      <!-- Column 3: Contact Info -->
      <div class="footer-col col-contact" id="footer-contact">
        <h4 class="col-title">Sekretariat & Kontak</h4>
        <div class="contact-info-block">
          <div class="c-item">
            <div class="c-icon-wrap">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <span>{settings.address || "Jl. Maruras No. 13, Slawi, Kabupaten Tegal, Jawa Tengah"}</span>
          </div>
          <div class="c-item">
            <div class="c-icon-wrap">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <span>{rawPhone}</span>
          </div>
          <div class="c-item">
            <div class="c-icon-wrap">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <span>{emailAddr}</span>
          </div>
        </div>
      </div>

      <!-- Column 4: Official Social Channels -->
      <div class="footer-col col-social">
        <h4 class="col-title">Media Sosial Resmi</h4>
        <p class="social-note">Ikuti kanal informasi kegiatan & gerakan relawan BMI Tegal:</p>
        <div class="social-icon-row">
          <a href={settings.social?.instagram || "#"} target="_blank" rel="noopener noreferrer" class="social-icon-circle" aria-label="Instagram" title="Instagram">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href={settings.social?.facebook || "#"} target="_blank" rel="noopener noreferrer" class="social-icon-circle" aria-label="Facebook" title="Facebook">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href={settings.social?.youtube || "#"} target="_blank" rel="noopener noreferrer" class="social-icon-circle" aria-label="YouTube" title="YouTube">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Copyright Bar -->
  <div class="footer-bottom">
    <div class="footer-container bottom-flex">
      <p class="copyright-text">
        © {new Date().getFullYear()} DPC Banteng Muda Indonesia Kab. Tegal. Hak Cipta Dilindungi.
      </p>
      <div class="developer-credit">
        <span>Dikelola oleh <strong>Penanggung Jawab Divisi IT</strong></span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #0F172A;
    color: #94A3B8;
    font-size: 0.88rem;
    margin-top: auto;
    width: 100%;
    position: relative;
    border-top: 3px solid var(--primary-red);
  }

  .footer-main {
    padding: 50px 0 40px 0;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
    display: grid;
    grid-template-columns: 1.3fr 0.9fr 1.2fr 1fr;
    gap: 36px;
    align-items: start;
  }

  @media (max-width: 768px) {
    .footer-container {
      padding-left: 16px;
      padding-right: 16px;
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  /* Logo & Brand Column */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 16px;
  }

  .footer-logo-img {
    width: 40px;
    height: 40px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
    background: #FFFFFF;
    border-radius: 50%;
    padding: 3px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .footer-logo-divider {
    width: 2px;
    height: 32px;
    background-color: var(--primary-red);
    flex-shrink: 0;
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 0.98;
  }

  .footer-brand-line {
    font-size: 0.68rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 0.3px;
    font-family: var(--font-heading);
    text-transform: uppercase;
  }

  .footer-brand-region {
    font-size: 0.54rem;
    font-weight: 700;
    color: #94A3B8;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    margin-top: 2px;
  }

  .footer-desc {
    line-height: 1.6;
    color: #94A3B8;
    font-size: 0.85rem;
    margin-bottom: 16px;
  }

  .brand-slogan-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(227, 6, 19, 0.1);
    border: 1px solid rgba(227, 6, 19, 0.3);
    color: #F8FAFC;
    font-size: 0.76rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 20px;
    width: fit-content;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--primary-red);
  }

  /* Titles */
  .col-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 18px;
    font-family: var(--font-heading);
    position: relative;
    padding-bottom: 8px;
  }

  .col-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background-color: var(--primary-red);
    border-radius: 2px;
  }

  /* Navigation Links - Div base, zero UL/LI */
  .footer-nav-menu {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .f-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #CBD5E1;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.88rem;
    transition: all 0.2s ease;
  }

  .f-link-arrow {
    color: var(--primary-red);
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .f-link:hover {
    color: var(--primary-red);
    transform: translateX(3px);
  }

  .f-link:hover .f-link-arrow {
    transform: translateX(2px);
  }

  /* Contact Items - Div base */
  .contact-info-block {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .c-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #CBD5E1;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .c-icon-wrap {
    color: var(--primary-red);
    flex-shrink: 0;
    margin-top: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Social Media Icon Row */
  .social-note {
    font-size: 0.84rem;
    color: #94A3B8;
    margin-bottom: 14px;
    line-height: 1.5;
  }

  .social-icon-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .social-icon-circle {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: #1E293B;
    color: #F1F5F9;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.25s ease;
    text-decoration: none;
    flex-shrink: 0;
  }

  .social-icon-circle:hover {
    background-color: var(--primary-red);
    color: #FFFFFF;
    border-color: var(--primary-red);
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(227, 6, 19, 0.4);
  }

  /* Bottom Copyright Bar */
  .footer-bottom {
    background-color: #0B1120;
    padding: 16px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .bottom-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .copyright-text {
    font-size: 0.82rem;
    color: #64748B;
    margin: 0;
  }

  .developer-credit {
    font-size: 0.78rem;
    color: #94A3B8;
  }

  .developer-credit strong {
    color: #E2E8F0;
    font-weight: 600;
  }

  /* Responsive Breakpoints */
  @media (max-width: 992px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 768px) {
    .bottom-flex {
      flex-direction: column;
      text-align: center;
      justify-content: center;
      gap: 6px;
    }
  }

  @media (max-width: 640px) {
    .footer-main {
      padding: 40px 0 30px 0;
    }
    .footer-container {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .social-card-btn {
      max-width: 100%;
    }
  }
</style>
